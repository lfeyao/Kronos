[Unit]
Description=Kronos guest VPN-only egress policy
DefaultDependencies=no
After=local-fs.target
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/kronos-egress.nft
RemainAfterExit=yes
# Deliberately no ExecStop that removes the firewall.

[Install]
WantedBy=sysinit.target
